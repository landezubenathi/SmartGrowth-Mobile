# Copy to frontend/.env.local and enter YOUR Firebase project's Web App configuration.
# These are Firebase public project identifiers, NEVER service account private keys.
REACT_APP_FIREBASE_API_KEY=YOUR_FIREBASE_PUBLIC_WEB_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
REACT_APP_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID

# Optional: HTTPS Cloudflare Worker from cloudflare/treasury-worker.js.
# Needed for static websites when the Treasury origin does not allow browser CORS.
# Android/iOS Capacitor builds call official API directly via native HTTP.
REACT_APP_TREASURY_PROXY_URL=
