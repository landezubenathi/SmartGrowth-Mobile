# Template only. The working configuration is in .env.local (Git-ignored).
# Obtain the public Web App configuration from Firebase Console > Project settings.
REACT_APP_FIREBASE_API_KEY=YOUR_FIREBASE_PUBLIC_WEB_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
REACT_APP_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
# Optional web app identifiers (not necessary for authentication or Firestore):
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
# Optional deployed HTTPS relay for browsers fetching National Treasury OCDS data:
REACT_APP_TREASURY_PROXY_URL=
