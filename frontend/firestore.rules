rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsWorkspace(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validBusiness(uid, businessId) {
      let data = request.resource.data;
      return data.keys().hasAll(['payload', 'ownerUid', 'modifiedAt'])
        && data.keys().hasOnly(['payload', 'ownerUid', 'modifiedAt'])
        && data.ownerUid == uid
        && data.modifiedAt is string
        && data.payload is map
        && data.payload.keys().hasAll(['id', 'name'])
        && data.payload.id == businessId
        && data.payload.name is string;
    }

    match /users/{uid}/businesses/{businessId} {
      allow get, list: if ownsWorkspace(uid);
      allow create: if ownsWorkspace(uid) && validBusiness(uid, businessId);
      allow update: if ownsWorkspace(uid)
        && resource.data.ownerUid == uid
        && validBusiness(uid, businessId);
      allow delete: if false;
    }

    // Simulated registry records are PRIVATE to the authenticated account.
    // These are not official CIPC data or government validation.
    function validPracticeRegistry(uid, businessId) {
      let d = request.resource.data;
      return request.auth != null && request.auth.uid == uid
        && d.keys().hasAll(['ownerUid','businessId','email','businessName','industry','province','registrationNumber','source','status','createdAt','modifiedAt'])
        && d.keys().hasOnly(['ownerUid','businessId','email','businessName','industry','province','registrationNumber','source','status','createdAt','modifiedAt'])
        && d.ownerUid == uid && d.businessId == businessId
        && d.email == request.auth.token.email
        && d.source == 'smartgrowth-simulated-registry'
        && d.status == 'practice'
        && d.businessName is string && d.businessName.size() >= 3 && d.businessName.size() <= 90
        && d.industry is string && d.industry.size() > 0 && d.industry.size() <= 80
        && d.province is string && d.province.size() > 0 && d.province.size() <= 80
        && d.registrationNumber is string
        && d.registrationNumber.matches('^[0-9]{4}/[0-9]{6}/07$')
        && d.createdAt is string && d.modifiedAt is string;
    }
    match /users/{uid}/simulatedRegistry/{businessId} {
      allow get, list: if ownsWorkspace(uid);
      allow create: if ownsWorkspace(uid) && validPracticeRegistry(uid, businessId);
      allow update: if ownsWorkspace(uid)
        && resource.data.ownerUid == uid && resource.data.businessId == businessId
        && validPracticeRegistry(uid, businessId);
      allow delete: if ownsWorkspace(uid);
    }

    // Public marketplace: anyone may read published offers, but only an
    // authenticated owner may create/update/remove their own limited public listing.
    function validOffer() {
      let d = request.resource.data;
      return d.keys().hasAll(['ownerUid','businessId','businessName','industry','province','name','description','price','status','createdAt'])
        && d.keys().hasOnly(['ownerUid','businessId','businessName','industry','province','name','description','price','status','createdAt'])
        && request.auth != null && d.ownerUid == request.auth.uid
        && d.businessId is string && d.businessId.size() <= 150
        && d.businessName is string && d.businessName.size() <= 90
        && d.industry is string && d.industry.size() <= 80
        && d.province is string && d.province.size() <= 80
        && d.name is string && d.name.size() > 0 && d.name.size() <= 90
        && d.description is string && d.description.size() > 0 && d.description.size() <= 500
        && d.price is number && d.price > 0 && d.price <= 100000000
        && d.status == 'published' && d.createdAt is string;
    }
    match /marketplace/{offerId} {
      allow get, list: if resource.data.status == 'published';
      allow create: if validOffer() && offerId.matches('offer_[A-Za-z0-9_]+');
      allow update: if validOffer() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.businessId == resource.data.businessId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Private enquiries: senders explicitly share contact details with the
    // owner of a real published listing. Never expose personal contact
    // information through /marketplace or to other marketplace browsers.
    function validMarketEnquiry(enquiryId) {
      let d = request.resource.data;
      let offerPath = /databases/$(database)/documents/marketplace/$(d.offerId);
      let senderBusinessPath = /databases/$(database)/documents/users/$(request.auth.uid)/businesses/$(d.senderBusinessId);
      return request.auth != null
        && d.keys().hasAll(['offerId','ownerUid','ownerBusinessId','offerName',
           'senderUid','senderBusinessId','senderBusinessName','senderIndustry',
           'senderProvince','senderName','senderEmail','senderPhone','message',
           'intent','status','createdAt','updatedAt'])
        && d.keys().hasOnly(['offerId','ownerUid','ownerBusinessId','offerName',
           'senderUid','senderBusinessId','senderBusinessName','senderIndustry',
           'senderProvince','senderName','senderEmail','senderPhone','message',
           'intent','status','createdAt','updatedAt'])
        && d.offerId is string && d.offerId.matches('^offer_[A-Za-z0-9_]+$')
        && d.senderUid == request.auth.uid
        && enquiryId == 'interest_' + d.offerId + '_' + request.auth.uid
        && d.ownerUid is string && d.ownerUid != request.auth.uid
        && d.ownerBusinessId is string && d.ownerBusinessId.size() <= 150
        && d.senderBusinessId is string && d.senderBusinessId.size() <= 150
        && d.senderBusinessName is string && d.senderBusinessName.size() > 0 && d.senderBusinessName.size() <= 90
        && d.senderIndustry is string && d.senderIndustry.size() <= 80
        && d.senderProvince is string && d.senderProvince.size() <= 80
        && d.senderName is string && d.senderName.size() >= 2 && d.senderName.size() <= 100
        && d.senderEmail == request.auth.token.email
        && d.senderPhone is string && d.senderPhone.size() <= 30
        && d.message is string && d.message.size() >= 10 && d.message.size() <= 1000
        && d.intent in ['interest', 'quotation']
        && d.status == 'new'
        && d.createdAt is string && d.updatedAt is string
        && exists(offerPath)
        && get(offerPath).data.status == 'published'
        && get(offerPath).data.ownerUid == d.ownerUid
        && get(offerPath).data.businessId == d.ownerBusinessId
        && get(offerPath).data.name == d.offerName
        && exists(senderBusinessPath)
        && get(senderBusinessPath).data.ownerUid == request.auth.uid
        && get(senderBusinessPath).data.payload.name == d.senderBusinessName;
    }
    match /marketEnquiries/{enquiryId} {
      // Caller must query by ownerUid or senderUid. Other users cannot
      // enumerate the collection or see enquiry contact details.
      allow get, list: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.senderUid == request.auth.uid);
      allow create: if validMarketEnquiry(enquiryId);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['contacted','closed']
        && request.resource.data.updatedAt is string;
      allow delete: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.senderUid == request.auth.uid);
    }

    // All other paths remain denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
