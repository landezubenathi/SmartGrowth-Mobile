rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsWorkspace(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validBusiness(uid, businessId) {
      let data = request.resource.data;
      return data.keys().hasAll(['payload', 'ownerUid', 'modifiedAt'])
        && data.keys().hasOnly(['payload', 'ownerUid', 'modifiedAt'])
        && data.ownerUid == uid
        && data.modifiedAt is string
        && data.payload is map
        && data.payload.keys().hasAll(['id', 'name'])
        && data.payload.id == businessId
        && data.payload.name is string;
    }

    match /users/{uid}/businesses/{businessId} {
      allow get, list: if ownsWorkspace(uid);
      allow create: if ownsWorkspace(uid) && validBusiness(uid, businessId);
      allow update: if ownsWorkspace(uid)
        && resource.data.ownerUid == uid
        && validBusiness(uid, businessId);
      allow delete: if false;
    }

    // All other paths remain denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
